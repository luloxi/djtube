{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djtube",
  "account_id": "124b4210ff80c15610ed109083a5cf95",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "dj.lulox.com.ar", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Secrets (wrangler secret put, never in this file): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, YT_API_KEY.
  // Sends approval mail from djtube@lulox.com.ar once Email Sending is onboarded.
  // Does not configure Email Routing or MX.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["djtube@lulox.com.ar"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djtube",
      "database_id": "e343e8cf-ff15-4841-9728-e830a9381684",
      "migrations_dir": "migrations"
    }
  ]
}
