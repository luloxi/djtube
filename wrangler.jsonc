{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djtube",
  "account_id": "124b4210ff80c15610ed109083a5cf95",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "dj.lulox.com.ar", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Secrets (wrangler secret put, never in this file): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, YT_API_KEY, RESEND_API_KEY.
  // Approval mail is Resend, from "DJTube <no-responder@lulox.com.ar>" or APPROVAL_FROM.
  // Rate limits (Workers Rate Limiting, free): see worker/ratelimit.ts. Per IP, per Cloudflare location.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "2101", "simple": { "limit": 60, "period": 10 } },
    { "name": "HEAVY_LIMIT", "namespace_id": "2102", "simple": { "limit": 12, "period": 10 } },
    { "name": "OEMBED_LIMIT", "namespace_id": "2104", "simple": { "limit": 150, "period": 10 } },
    { "name": "EXEMPT_LIMIT", "namespace_id": "2103", "simple": { "limit": 5, "period": 10 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djtube",
      "database_id": "e343e8cf-ff15-4841-9728-e830a9381684",
      "migrations_dir": "migrations"
    }
  ]
}
